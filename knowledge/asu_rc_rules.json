  "diagnosisRules": [
    {
      "id": "slurm-oom",
      "cluster": "any",
      "category": "OUT_OF_MEMORY",
      "requiresCorroboration": true,
      "triggers": ["oom_kill", "out of memory"],
      "corroboration": ["State=OUT_OF_MEMORY", "MaxRSS near ReqMem"],
      "exclusions": ["Exit code alone"],
      "source": "https://docs.rc.asu.edu/job-statistics/"
    },
    {
      "id": "slurm-timeout",
      "cluster": "any",
      "category": "TIMEOUT",
      "requiresCorroboration": true,
      "triggers": ["time limit", "timeout"],
      "corroboration": ["State=TIMEOUT"],
      "exclusions": ["Application timeout without Slurm state"],
      "source": "https://docs.rc.asu.edu/jobstates/"
    },
    {
      "id": "slurm-invalid-feature",
      "cluster": "any",
      "category": "INVALID_PARTITION_OR_QOS_OR_CONSTRAINT",
      "requiresCorroboration": true,
      "triggers": ["Invalid feature specification"],
      "corroboration": ["Submitted partition, QoS, and constraint directives"],
      "exclusions": ["Do not select one cause from the message alone"],
      "source": "https://docs.rc.asu.edu/slurm-sbatch/"
    },
    {
      "id": "slurm-command-not-found",
      "cluster": "any",
      "category": "COMMAND_NOT_FOUND_OR_MODULE",
      "requiresCorroboration": false,
      "triggers": ["command not found", "module not found", "execve(): executable: No such file or directory"],
      "corroboration": [],
      "exclusions": ["Do not invent a replacement module name"],
      "source": "https://docs.rc.asu.edu/slurm-sbatch/"
    },
    {
      "id": "slurm-pending",
      "cluster": "any",
      "category": "PENDING_NOT_FAILED",
      "requiresCorroboration": false,
      "triggers": ["Priority", "Resources", "QOSMax", "ReqNodeNotAvail"],
      "corroboration": ["State=PENDING"],
      "exclusions": ["Do not describe pending work as a failed job"],
      "source": "https://docs.rc.asu.edu/jobstates/"
    },
    {
      "id": "slurm-infrastructure",
      "cluster": "any",
      "category": "INFRASTRUCTURE_OR_ADMIN",
      "requiresCorroboration": false,
      "triggers": ["drain", "maintenance", "node down"],
      "corroboration": [],
      "exclusions": ["Do not rewrite the application command"],
      "source": "https://docs.rc.asu.edu/jobstates/"
    }
  ]
}
